{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<YOUR_DB_HOST>;Port=5432;Database=<YOUR_DB_NAME>;Username=<YOUR_DB_USERNAME>;Password=<YOUR_DB_PASSWORD>"
  },
  "JwtConfig": {
    "Secret": "<YOUR_JWT_SECRET>",
    "Issuer": "https://api.smartqrcoffee.local",
    "Audience": "https://app.smartqrcoffee.local",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RequireHttpsMetadata": false,
    "Cookie": {
      "AccessTokenName": "access_token",
      "RefreshTokenName": "refresh_token",
      "HttpOnly": true,
      "SecurePolicy": "SameAsRequest",
      "SameSite": "Strict"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  }
}
